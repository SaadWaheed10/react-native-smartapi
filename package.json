{
  "name": "react-native-smartapi",
  "version": "1.4.0",
  "description": "Enterprise-grade API layer for React Native and Expo. Screen APIs, adaptive networking, circuit breaker, ETag, offline conflicts, resources, Suspense, streaming, and React hooks — no Axios required.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./testing": {
      "types": "./lib/typescript/testing/index.d.ts",
      "import": "./lib/module/testing/index.js",
      "require": "./lib/commonjs/testing/index.js",
      "default": "./lib/commonjs/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!lib/typescript/example",
    "!**/__tests__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "rimraf lib",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "npm run build",
    "release": "npm run clean && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "api",
    "http-client",
    "networking",
    "axios-alternative",
    "typescript",
    "hooks",
    "interceptors",
    "cache",
    "offline-first",
    "retry",
    "error-handling",
    "tanstack-query-alternative"
  ],
  "author": "Saad Waheed Khan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saadwaheed10/react-native-smartapi.git"
  },
  "homepage": "https://github.com/saadwaheed10/react-native-smartapi#readme",
  "bugs": {
    "url": "https://github.com/saadwaheed10/react-native-smartapi/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.15.0",
    "@react-native-community/netinfo": ">=9.0.0",
    "react": ">=17.0.0",
    "react-native": ">=0.65.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "@react-native-community/netinfo": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/netinfo": "^11.3.1",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.79",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-builder-bob": "^0.23.2",
    "react-test-renderer": "18.2.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=16"
  },
  "jest": {
    "preset": "react-native",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/types/**"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
